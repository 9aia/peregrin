# Local development — override sepia git deps with sibling checkouts.
# Append to .cargo/config.toml (committed — it carries the xtask alias).
[patch."ssh://git@github.com/9aia/sepia.git"]
sepia-core = { path = "../sepia/crates/sepia-core" }
sepia-proto = { path = "../sepia/crates/sepia-proto" }
sepia-acp = { path = "../sepia/crates/sepia-acp" }
sepia-session = { path = "../sepia/crates/sepia-session" }
sepia-driver = { path = "../sepia/crates/sepia-driver" }
sepia-host = { path = "../sepia/crates/sepia-host" }
sepia-meta = { path = "../sepia/crates/sepia-meta" }
sepia-convert = { path = "../sepia/crates/sepia-convert" }
sepia-testkit = { path = "../sepia/crates/sepia-testkit" }
sepia-driver-devin = { path = "../sepia/crates/sepia-driver-devin" }
sepia-driver-cline = { path = "../sepia/crates/sepia-driver-cline" }
sepia-driver-claude = { path = "../sepia/crates/sepia-driver-claude" }
sepia-driver-cursor = { path = "../sepia/crates/sepia-driver-cursor" }

# Same trick for bupha's ci-job adapter — sibling checkout at
# ../bupha (its in-workspace bupha-plane/bupha-config-file deps
# resolve inside the same checkout).
[patch."ssh://git@github.com/9aia/bupha.git"]
bupha-peregrin = { path = "../bupha/crates/bupha-peregrin" }

# Same trick for the extracted hypha substrate crates — sibling
# checkout at ../hypha. The patch key is the https spelling the
# manifests declare (org-wide since PL-032).
[patch."https://github.com/9aia/hypha.git"]
hypha-node-api = { path = "../hypha/crates/hypha-node-api" }
hypha-outbox = { path = "../hypha/crates/hypha-outbox" }
hypha-control = { path = "../hypha/crates/hypha-control" }
hypha-sync = { path = "../hypha/crates/hypha-sync" }
hypha-push = { path = "../hypha/crates/hypha-push" }
hypha-http = { path = "../hypha/crates/hypha-http" }
hypha-hub = { path = "../hypha/crates/hypha-hub" }
hypha-kv = { path = "../hypha/crates/hypha-kv" }
hypha-kv-file = { path = "../hypha/crates/hypha-kv-file" }
