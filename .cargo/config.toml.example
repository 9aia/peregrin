# Local development — override sepia git deps with sibling checkouts.
# Copy to .cargo/config.toml (gitignored).
[patch."ssh://git@github.com/9aia/sepia.git"]
sepia-core = { path = "../sepia/crates/sepia-core" }
sepia-proto = { path = "../sepia/crates/sepia-proto" }
sepia-acp = { path = "../sepia/crates/sepia-acp" }
sepia-session = { path = "../sepia/crates/sepia-session" }
sepia-driver = { path = "../sepia/crates/sepia-driver" }
sepia-host = { path = "../sepia/crates/sepia-host" }
sepia-meta = { path = "../sepia/crates/sepia-meta" }
sepia-convert = { path = "../sepia/crates/sepia-convert" }
sepia-testkit = { path = "../sepia/crates/sepia-testkit" }
sepia-driver-devin = { path = "../sepia/crates/sepia-driver-devin" }
sepia-driver-cline = { path = "../sepia/crates/sepia-driver-cline" }
sepia-driver-claude = { path = "../sepia/crates/sepia-driver-claude" }
sepia-driver-cursor = { path = "../sepia/crates/sepia-driver-cursor" }
