fn.tap(
  (s) -> [
    fs.write("examples/ac/servers/05-filesystem/greeting.txt", "Hello from AC files"),
    http_server.route(
      s,
      "GET",
      "/greeting",
      fs.read("examples/ac/servers/05-filesystem/greeting.txt")
    ),
    http_server.start(s, "127.0.0.1:8085"),
    http_server.join(s)
  ],
  http_server.new()
)
