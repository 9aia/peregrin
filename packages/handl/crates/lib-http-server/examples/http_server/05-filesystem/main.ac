fn.tap(
  (s) -> [
    fs.write("crates/lib-http-server/examples/http_server/05-filesystem/greeting.txt", "Hello from handl files"),
    http_server.route(
      s,
      "GET",
      "/greeting",
      fs.read("crates/lib-http-server/examples/http_server/05-filesystem/greeting.txt")
    ),
    http_server.start(s, "127.0.0.1:8085"),
    http_server.join(s)
  ],
  http_server.new()
)
