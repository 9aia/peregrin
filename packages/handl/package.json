{
  "name": "handl-docs",
  "version": "1.0.0",
  "private": true,
  "description": "VitePress documentation for handl",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:gen-api": "cargo +nightly doc-md --workspace --no-deps --include-private -o docs/api",
    "docs:gen-ref": "cargo run -p handl-reference-gen",
    "docs:build": "bun run docs:gen-api && bun run docs:gen-ref && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "next"
  }
}
